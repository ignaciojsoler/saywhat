# Transcription (Cloudflare Workers AI, token with "Workers AI" permission)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: "Continue with Google" (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database: a local SQLite file in dev; a Turso URL (libsql://…) + token in production
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Payments (Mercado Pago Checkout Pro). Use TEST credentials while developing.
MP_ACCESS_TOKEN=
# Webhook secret from Mercado Pago → Your integrations → Webhooks (event: Payments)
MP_WEBHOOK_SECRET=
# Public base URL used for checkout return URLs and webhooks (must be https in production)
APP_URL=http://localhost:3000

# International payments in USD (Paddle Billing, merchant of record). Use a SANDBOX account while developing.
# sandbox | production (selects https://sandbox-api.paddle.com or https://api.paddle.com)
PADDLE_ENV=sandbox
# Paddle → Developer tools → Authentication → API keys (permissions: transactions read + write)
PADDLE_API_KEY=
# Client-side token from the same page (test_… in sandbox, live_… in production)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Product "Saywhat video credits" (Catalog → Products, tax category: Standard digital goods / SaaS)
PADDLE_PRODUCT_ID=
# Secret key of the notification destination pointing at <APP_URL>/api/webhooks/paddle
PADDLE_WEBHOOK_SECRET=
